<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>CryptoClients.Net</PackageId>
    <Authors>JKorf</Authors>
    <PackageVersion>5.7.2</PackageVersion>
    <AssemblyVersion>5.7.2</AssemblyVersion>
    <FileVersion>5.7.2</FileVersion>
    <Description>Access 30 cryptocurrency exchanges through one Shared API and reusable, exchange-agnostic code, while retaining full access to each exchange's complete API. Supports Binance, Bybit, Hyperliquid, and many more.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>CryptoClients;CryptoClients.Net;Aster;Aster.Net;Binance;Binance.Net;BingX;BingX.Net;Bitfinex;Bitfinex.Net;Bitget;Bitget.Net;BitMart;BitMart.Net;BitMEX;BitMEX.Net;Bitstamp;Bitstamp.Net;BloFin;BloFin.Net;Bybit;Bybit.Net;Coinbase;Coinbase.Net;CoinEx;CoinEx.Net;Coingecko;Coingecko.Net;CoinW;CoinW.Net;Crypto;CryptoCom;Crypto.com;CryptoCom.Net;DeepCoin;DeepCoin.Net;GateIo;Gate;Gate.com;GateIo.Net;HTX;HTX.Net;HyperLiquid;HyperLiquid.Net;Kraken;KrakenExchange;Kraken.Net;Kucoin;Kucoin.Net;LBank;LBank.Net;Lighter;Lighter.Net;Mexc;Mexc.Net;OKX;OKX.Net;Pionex;Pionex.Net;Polymarket;Polymarket.Net;Tapbit;Tapbit.Net;Toobit;Toobit.Net;Upbit;Upbit.Net;Weex;Weex.Net;WhiteBit;WhiteBit.Net;XT;XT.Net;CryptoExchange.Net;CryptoCurrency;CryptoCurrency Exchange;ccxt</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JKorf/CryptoClients.Net.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/JKorf/CryptoClients.Net</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <PackageReleaseNotes>https://github.com/JKorf/CryptoClients.Net?tab=readme-ov-file#release-notes</PackageReleaseNotes>
    <NoWarn>$(NoWarn);SYSLIB1100;SYSLIB1101</NoWarn>
  </PropertyGroup>
  <PropertyGroup Label="AOT" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Icon\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup Label="Deterministic Build" Condition="'$(Configuration)' == 'Release'">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Label="Deterministic Build" Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ConfigureAwaitChecker.Analyzer" Version="5.0.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Aster.Net\Aster.Net\Aster.Net.csproj" />
    <ProjectReference Include="..\..\Binance.Net\Binance.Net\Binance.Net.csproj" />
    <ProjectReference Include="..\..\BingX.Net\BingX.Net\BingX.Net.csproj" />
    <ProjectReference Include="..\..\Bitfinex.Net\Bitfinex.Net\Bitfinex.Net.csproj" />
    <ProjectReference Include="..\..\Bitget.Net\Bitget.Net\Bitget.Net.csproj" />
    <ProjectReference Include="..\..\BitMart.Net\BitMart.Net\BitMart.Net.csproj" />
    <ProjectReference Include="..\..\BitMEX.Net\BitMEX.Net\BitMEX.Net.csproj" />
    <ProjectReference Include="..\..\Bitstamp.Net\Bitstamp.Net\Bitstamp.Net.csproj" />
    <ProjectReference Include="..\..\BloFin.Net\BloFin.Net\BloFin.Net.csproj" />
    <ProjectReference Include="..\..\Bybit.Net\ByBit.Net\Bybit.Net.csproj" />
    <ProjectReference Include="..\..\Coinbase.Net\Coinbase.Net\Coinbase.Net.csproj" />
    <ProjectReference Include="..\..\CoinEx.Net\CoinEx.Net\CoinEx.Net.csproj" />
    <ProjectReference Include="..\..\CoinGecko.Net\CoinGecko.Net\CoinGecko.Net.csproj" />
    <ProjectReference Include="..\..\CoinW.Net\CoinW.Net\CoinW.Net.csproj" />
    <ProjectReference Include="..\..\CryptoCom.Net\CryptoCom.Net\CryptoCom.Net.csproj" />
    <ProjectReference Include="..\..\CryptoExchange.Net\CryptoExchange.Net\CryptoExchange.Net.csproj" />
    <ProjectReference Include="..\..\DeepCoin.Net\DeepCoin.Net\DeepCoin.Net.csproj" />
    <ProjectReference Include="..\..\GateIo.Net\GateIo.Net\GateIo.Net.csproj" />
    <ProjectReference Include="..\..\HTX.Net\HTX.Net\HTX.Net.csproj" />
    <ProjectReference Include="..\..\HyperLiquid.Net\HyperLiquid.Net\HyperLiquid.Net.csproj" />
    <ProjectReference Include="..\..\Kraken.Net\Kraken.Net\Kraken.Net.csproj" />
    <ProjectReference Include="..\..\Kucoin.Net\Kucoin.Net\Kucoin.Net.csproj" />
    <ProjectReference Include="..\..\LBank.Net\LBank.Net\LBank.Net.csproj" />
    <ProjectReference Include="..\..\Lighter.Net\Lighter.Net\Lighter.Net.csproj" />
    <ProjectReference Include="..\..\Mexc.Net\Mexc.Net\Mexc.Net.csproj" />
    <ProjectReference Include="..\..\OKX.Net\OKX.Net\OKX.Net.csproj" />
    <ProjectReference Include="..\..\Pionex.Net\Pionex.Net\Pionex.Net.csproj" />
    <ProjectReference Include="..\..\Polymarket.Net\Polymarket.Net\Polymarket.Net.csproj" />
    <ProjectReference Include="..\..\Tapbit.Net\Tapbit.Net\Tapbit.Net.csproj" />
    <ProjectReference Include="..\..\Toobit.Net\Toobit.Net\Toobit.Net.csproj" />
    <ProjectReference Include="..\..\Upbit.Net\Upbit.Net\Upbit.Net.csproj" />
    <ProjectReference Include="..\..\Weex.Net\Weex.Net\Weex.Net.csproj" />
    <ProjectReference Include="..\..\WhiteBit.Net\WhiteBit.Net\WhiteBit.Net.csproj" />
    <ProjectReference Include="..\..\XT.Net\XT.Net\XT.Net.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <DocumentationFile>CryptoClients.Net.xml</DocumentationFile>
  </PropertyGroup>
</Project>